{
  "name": "knowledge-terminal",
  "version": "0.1.0",
  "description": "A local-first learning workspace. Markdown in, focus out.",
  "author": {
    "name": "Steven",
    "email": "steven@agrader.sg"
  },
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "package": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "image-size": "^1.2.0",
    "minisearch": "^7.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.2",
    "@shikijs/rehype": "^3.2.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^8.57.1",
    "fuzzysort": "^3.1.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^0.475.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^3.2.1",
    "typescript": "^5.7.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^6.1.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "homepage": "https://github.com/local/knowledge-terminal",
  "build": {
    "appId": "sg.agrader.knowledgeterminal",
    "productName": "Knowledge Terminal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "A local-first Markdown reading workspace.",
      "description": "Opens any folder of Markdown as a focused reading workspace: search, a derived document graph, and a layered answer system. No network, no account, no telemetry.",
      "desktop": {
        "Name": "Knowledge Terminal",
        "Comment": "A local-first Markdown reading workspace",
        "Categories": "Office;Utility;TextEditor;",
        "Keywords": "markdown;notes;reading;knowledge;",
        "StartupWMClass": "Knowledge Terminal"
      }
    }
  }
}
